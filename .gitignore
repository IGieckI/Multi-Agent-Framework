# Game data is downloaded by scripts/fetch_data.py and never committed (CLAUDE.md rule 4)
data/
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.hypothesis/

# where the cluster writes its runs (the downloaded copies live in run_*/ and are committed)
/runs
# the cluster's Slurm outputs and sweep logs in the repo root (untracked files make a run's code "dirty", F41)
/shard*.jsonl
/slurm-*.out
/slurm-*.err
# the lists of a grid's Slurm logs, written on giano for the download
/slurm_*.txt
# the cluster's documentation and a colleague's guide: not ours to publish
/docsHPC
# private notes, never committed
/framework/stuff.md
# answers of finished runs scored again (scripts/rescore.py): outside the run folders, untracked on giano (F41)
/runs_confidence
